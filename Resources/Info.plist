<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>CFBundleDevelopmentRegion</key>
  <string>en</string>
  <key>CFBundleExecutable</key>
  <string>copyz</string>
  <key>CFBundleIdentifier</key>
  <string>app.copyz.mac</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>copyz</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>1</string>
  <key>LSMinimumSystemVersion</key>
  <string>15.0</string>

  <!-- Menu-bar-only app: no Dock icon, no app switcher entry. -->
  <key>LSUIElement</key>
  <true/>

  <key>NSHighResolutionCapable</key>
  <true/>

  <!-- Needed to synthesise a paste into whatever app the user was using.
       Covers the CGEvent "PostEvent" TCC service, shown under Accessibility. -->
  <key>NSAppleEventsUsageDescription</key>
  <string>copyz needs Accessibility access to paste clipboard items into the app you were using.</string>

  <!-- Launch at login via SMAppService. -->
  <key>SMAppServiceUsageDescription</key>
  <string>copyz records your clipboard history while running.</string>
</dict>
</plist>